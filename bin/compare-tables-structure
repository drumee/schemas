#!/bin/bash
#
# Compare table structures (DDL only, no data) between two databases.
#
# Usage: compare-tables-structure [--id] <db1|id1> <db2|id2>
#
# With --id, the two arguments are treated as entity ids and each is resolved
# to a database name via yp.entity_db().
#
# Reports tables present in only one database, and for tables present in
# both, shows a unified diff of their normalized CREATE TABLE statements.
# Exit status is non-zero when any difference is found.

use_id=0
args=()
for a in "$@"; do
  case $a in
    --id) use_id=1 ;;
    *) args+=("$a") ;;
  esac
done

if [ ${#args[@]} -ne 2 ]; then
  echo "Usage: $(basename $0) [--id] <db1|id1> <db2|id2>"
  exit 2
fi

# Resolve an entity id to its database name.
entity_db(){
  mariadb -N -e "select yp.entity_db('$1')"
}

if [ $use_id -eq 1 ]; then
  db1=$(entity_db "${args[0]}")
  db2=$(entity_db "${args[1]}")
  if [ -z "$db1" ] || [ -z "$db2" ]; then
    echo "Could not resolve db name from id (${args[0]}, ${args[1]})"
    exit 2
  fi
  db1_label="$db1 (${args[0]})"
  db2_label="$db2 (${args[1]})"
else
  db1=${args[0]}
  db2=${args[1]}
  db1_label=$db1
  db2_label=$db2
fi

get_tables(){
  mysql -e "show tables \G" $1 | \
    egrep -Ev '^\*' | \
    awk 'BEGIN { FS == "[: ]" } ; { print $2 }' | \
    sort
}

# Emit the normalized CREATE TABLE statement for a table, stripping
# volatile bits (AUTO_INCREMENT counter) so only structure is compared.
show_structure(){
  table=$1
  db=$2
  mysql -e "show create table $table \G" $db | \
    egrep -Ev '^\*' | \
    egrep -Ev '^ +Table:' | \
    sed -e "s/Create Table: //" | \
    sed -E "s/AUTO_INCREMENT=[0-9]+ //"
}

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

get_tables $db1 > "$tmp_dir/tables1"
get_tables $db2 > "$tmp_dir/tables2"

diffs=0

# Tables present in only one of the two databases.
only1=$(comm -23 "$tmp_dir/tables1" "$tmp_dir/tables2")
only2=$(comm -13 "$tmp_dir/tables1" "$tmp_dir/tables2")

if [ -n "$only1" ]; then
  diffs=1
  echo "=== Tables only in $db1_label ==="
  echo "$only1"
  echo
fi

if [ -n "$only2" ]; then
  diffs=1
  echo "=== Tables only in $db2_label ==="
  echo "$only2"
  echo
fi

# Tables present in both: compare structure.
common=$(comm -12 "$tmp_dir/tables1" "$tmp_dir/tables2")
for table in $common; do
  show_structure $table $db1 > "$tmp_dir/struct1"
  show_structure $table $db2 > "$tmp_dir/struct2"
  if ! diff -q "$tmp_dir/struct1" "$tmp_dir/struct2" > /dev/null; then
    diffs=1
    echo "=== Structure differs: $table ($db1_label vs $db2_label) ==="
    diff -u --label "$db1/$table" "$tmp_dir/struct1" \
            --label "$db2/$table" "$tmp_dir/struct2"
    echo
  fi
done

if [ $diffs -eq 0 ]; then
  echo "No structural differences between $db1_label and $db2_label."
fi

exit $diffs
