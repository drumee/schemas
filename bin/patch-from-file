#!/bin/bash
set -e
script_dir=$(dirname $(readlink -f $0))
schemas_dir=$(dirname $script_dir)
collation=$(mariadb -e "show variables like 'character_set_collations';")
target=$2
if [ "$collation" != "" ]; then
  mariadb -e "set GLOBAL character_set_collations='utf8mb4=utf8mb4_general_ci'"
fi
if [ -d $schemas_dir ]; then
  if [[ $target =~ ^(drumate|hub|common)$ ]]; then
    if [ -x /usr/sbin/drumee ]; then
      /usr/sbin/drumee stop factory
    fi
  fi
  $script_dir/patch.js --schemas=$schemas_dir --source=$1 --target=$target --orphan=remove --force 
else
    echo invalid schemas $schemas_dir 
fi

if [[ $target =~ ^(drumate|hub|common)$ ]]; then
  if [ -x /usr/sbin/drumee ]; then
    /usr/sbin/drumee start factory
  fi
fi
